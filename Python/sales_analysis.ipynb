# In[5]:


import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
df = pd.read_csv(r"C:\Users\prach\OneDrive\Desktop\Project\Project1\Sample - Superstore.csv")

df.head()
df.columns = df.columns.str.lower()
df.columns = df.columns.str.replace(' ', '_')
##Exploratory Data Analysis (EDA)
##Total Sales and Profit
total_sales = df['sales'].sum()
total_profit = df['profit'].sum()

print("Total Sales:", total_sales)
print("Total Profit:", total_profit)


# In[6]:


##Sales by Category
category_sales = df.groupby('category')['sales'].sum()

category_sales


# In[9]:


##Create Your First Chart 
category_sales.plot(kind='bar', figsize=(7,4))

plt.title("Sales by Category")
plt.xlabel("Category")
plt.ylabel("Total Sales")

plt.show()


# In[12]:


df['order_date'] = pd.to_datetime(df['order_date'])
df['year'] = df['order_date'].dt.year
##Sales Trend Over Time 
##"How are sales changing year by year?"
yearly_sales = df.groupby('year')['sales'].sum()

yearly_sales


# In[16]:


##Create sales trend chart
yearly_sales.plot(kind='line', marker='o', figsize=(7,4))

plt.title("Sales Trend by Year")
plt.xlabel("Year")
plt.ylabel("Total Sales")

plt.show()


# In[14]:


##Profit by Category
##"Which category is making the most profit?"
category_profit = df.groupby('category')['profit'].sum()

category_profit


# In[15]:


category_profit.plot(kind='bar', figsize=(7,4))

plt.title("Profit by Category")
plt.xlabel("Category")
plt.ylabel("Total Profit")

plt.show()


# In[17]:


##Top 10 Products by Sales
##"Which products generate the most revenue?"
top_products = (
    df.groupby('product_name')['sales']
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

top_products


# In[18]:


top_products.plot(kind='barh', figsize=(7,4))

plt.title("Top 10 Products by Sales")
plt.xlabel("Sales")
plt.ylabel("Product")

plt.show()


# In[22]:


##Loss-Making Products
##"Which products are causing financial losses?"
loss_products = (
    df.groupby('product_name')['profit']
    .sum()
    .sort_values()
    .head(10)
)

loss_products


# In[23]:


loss_products.plot(kind='barh', figsize=(7,4))

plt.title("Top 10 Loss-Making Products")
plt.xlabel("Loss")
plt.ylabel("Product Name")

plt.show()


# In[25]:


##Discount vs Profit Relationship
##"Do higher discounts increase sales but reduce profit?"
discount_profit = df.groupby('discount')['profit'].mean()

discount_profit


# In[30]:


discount_profit.plot(kind='line', marker='o', figsize=(7,4))

plt.title("Average Profit by Discount Level")
plt.xlabel("Discount")
plt.ylabel("Average Profit")

plt.show()


# In[27]:


##Customer Segment Analysis
segment_analysis = df.groupby('segment')[['sales','profit']].sum()

segment_analysis


# In[28]:


##Regional Analysis
region_analysis = df.groupby('region')[['sales','profit']].sum()

region_analysis


# In[29]:


region_analysis['sales'].plot(kind='bar', figsize=(7,4))

plt.title("Sales by Region")
plt.xlabel("Region")
plt.ylabel("Sales")

plt.show()


# In[31]:


df.to_csv("sales_cleaned.csv", index=False)


